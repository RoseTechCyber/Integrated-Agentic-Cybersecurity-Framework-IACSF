<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Enable container build/publish -->
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerImageName>reasoning-agent</ContainerImageName>
    <ContainerImageTag>latest</ContainerImageTag>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire Hosting core -->
    <PackageReference Include="Aspire.Hosting" Version="8.0.0-preview.*" />
    <!-- Azure-specific Aspire hosting extensions -->
    <PackageReference Include="Aspire.Hosting.Azure" Version="8.0.0-preview.*" />
    <!-- Optional: if you want to use Aspire.Hosting.Cosmos for cloud Cosmos DB -->
    <PackageReference Include="Aspire.Hosting.Cosmos" Version="8.0.0-preview.*" />
	 <!-- Cosmos SDK for JSON processing -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.*" />
	 <!-- Optional: logging, diagnostics -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
	 <!-- For local emulator container support -->
    <PackageReference Include="Microsoft.Azure.Cosmos.Emulator" Version="2.14.0" />
  </ItemGroup>

 </Project>
