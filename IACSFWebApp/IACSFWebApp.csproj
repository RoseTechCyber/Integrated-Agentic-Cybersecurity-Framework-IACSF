<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Enable container build/publish -->
    <PublishProfile>DefaultContainer</PublishProfile>
    <ContainerImageName>foundry-service</ContainerImageName>
    <ContainerImageTag>latest</ContainerImageTag>
  </PropertyGroup>

  <ItemGroup>
    <!-- Aspire hosting packages -->
    <PackageReference Include="Aspire.Hosting" Version="8.0.0-preview.*" />
    <PackageReference Include="Aspire.Hosting.Azure" Version="8.0.0-preview.*" />

    <!-- Cosmos DB SDK -->
    <PackageReference Include="Microsoft.Azure.Cosmos" Version="3.*" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.0" />
  </ItemGroup>

</Project>
